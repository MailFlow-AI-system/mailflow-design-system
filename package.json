{
  "name": "@mailflow/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MailFlow-AI-system/mailflow-design-system.git"
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "import": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./theme-script": {
      "types": "./src/theme/themeScript.ts",
      "import": "./src/theme/themeScript.ts",
      "default": "./src/theme/themeScript.ts"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./src/styles/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20",
    "tailwindcss": ">=4.1.18 <5"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.43.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.0",
    "vitest": "5.0.0"
  }
}
